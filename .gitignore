# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Large / local-only artifacts (data/* not data/ so the manifest can be re-included)
data/*
checkpoints/
wandb/
results/preds/
results/baselines/**/preds/
results/baselines/training/
results/baselines/source/
# Evaluation predictions and unfinished batches stay local; the records are versioned.
results/records/**/*.predictions.jsonl
results/records/**/*.progress/
results/noise-floor/**/*.predictions.jsonl
results/noise-floor/**/*.progress/
.judge_cache/

# Secrets & misc
.env
*.log
# Local release bundles and their manifests
artifacts/

# The manifest and split files define the benchmark (sizes, seeds, roles) — versioned.
!data/manifest.json
!data/splits/
!data/pools/
